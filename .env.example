# ForgeAI — Environment Variables
# Copy to .env and fill in values.
# ForgeAI is a local tool — most defaults work out of the box.

# ── forge-engine ──────────────────────────────────────────────────────────────

# Port for the local forge-engine API (used by the web UI)
FORGE_ENGINE_PORT=8000

# CORS origin for the web UI
CORS_ORIGINS=http://localhost:3000

# ── web UI ────────────────────────────────────────────────────────────────────

# forge-engine base URL (web UI fetches from this)
NEXT_PUBLIC_ENGINE_URL=http://localhost:8000

# ── Optional electricity cost tracking ────────────────────────────────────────

# Your electricity cost in EUR/kWh (used by 'forge plan' cost estimation)
KWH_COST_EUR=0.30

# ── Hardware overrides (optional) ─────────────────────────────────────────────

# Force-disable MLX even if installed (e.g. to test CUDA path on Apple Silicon)
# MLX_FORCE_DISABLE=false

# Which GPU to use if multiple are available (CUDA only)
# CUDA_VISIBLE_DEVICES=0
